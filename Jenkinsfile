pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'building the app'
            }
        }
        stage('Test') {
            steps {
                echo 'Running tests'
            }
        }        
        stage('deploy') {
            steps {
                echo 'Deploying the app'
            }
        }
        stage('Hello') {
            steps {
                echo 'Hello World'
            }
        }        
    }
}
